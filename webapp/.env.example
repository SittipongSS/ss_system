# ── Supabase ────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.

# Public (safe to expose to the browser) — used for Auth later.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER expose this. Used by API routes + migration script.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Private bucket for commercial evidence attached when a quotation becomes Won.
# Migration 0105 creates "sales-evidence" as a non-public bucket. Downloads are
# streamed through the authorized quotation API; never make this bucket public.
SUPABASE_PRIVATE_STORAGE_BUCKET=sales-evidence

# ── ที่เก็บไฟล์แนบ = Google Drive ที่เดียว ───────────────────
# (ทาง Supabase Storage ถูกตัดออก 2026-07-30 — ไม่มี STORAGE_BACKEND อีกแล้ว
#  ไฟล์แนบทุกใบขึ้น Shared Drive เสมอ · ตรวจการเชื่อมต่อได้ที่ ตั้งค่า → ที่เก็บไฟล์)
# Auth = Workload Identity Federation (Vercel OIDC → impersonate the service
# account). NO downloadable JSON key (org policy iam.disableServiceAccountKeyCreation).
# These values are NOT secret — they only point at the WIF pool + service account.
#
# audience = //iam.googleapis.com/projects/<PROJECT_NUMBER>/locations/global/workloadIdentityPools/<POOL>/providers/<PROVIDER>
GOOGLE_WIF_AUDIENCE=//iam.googleapis.com/projects/390750549158/locations/global/workloadIdentityPools/vercel-pool-prod/providers/vercel
GOOGLE_SA_EMAIL=ss-attachments@ss-system-storage.iam.gserviceaccount.com
# Shared Drive ID (from the Shared Drive URL: /drive/folders/<ID>). REQUIRED for drive.
GOOGLE_SHARED_DRIVE_ID=0AHmPv7Sg7PANUk9PVA
# (optional) put files under a subfolder of the Shared Drive instead of its root.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ── แจ้งเตือน ──────────────────────────────────────────────────────────────
# Google Chat ถูกถอดออกแล้ว — ช่องทางเดียวคือกระดิ่ง/กล่องข้อความในแอป
# (CHAT_WEBHOOK_APPROVALS / _SALES / _PM ไม่มีโค้ดตัวไหนอ่านอีกแล้ว ลบทิ้งได้)
# base URL ของระบบ ใช้ประกอบลิงก์ในอีเมล/การ์ดแจ้งเตือน
APP_BASE_URL=
# secret กัน endpoint cron ถูกยิงจากภายนอก — Vercel Cron แนบ Authorization: Bearer <ค่านี้> ให้อัตโนมัติ
CRON_SECRET=

# ── นำเข้าวันหยุดไทยจากปฏิทิน Google ──────────────────────────────────────
# ปฏิทินสาธารณะ อ่านได้โดยไม่ต้อง auth — ไม่เกี่ยวกับ WIF/service account ของ Drive
# ทั้งสองค่าไม่ต้องตั้งก็ใช้งานได้ (โค้ดมีค่า default ให้แล้ว)
# เปลี่ยน id นี้ = เปลี่ยนภาษา/ประเทศของชื่อวันหยุด (en.th#... จะได้ชื่ออังกฤษ)
GOOGLE_HOLIDAY_CALENDAR_ID=th.th#holiday@group.v.calendar.google.com
# override URL ICS ทั้งเส้น — ใช้เมื่อจะชี้ปฏิทินบริษัทเองหรือ mirror ภายใน
GOOGLE_HOLIDAY_ICS_URL=
